{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@locales/*": ["./src/locales/*"],
      "@sections/*": ["./src/sections/*"],
      "@utils/*": ["./src/utils/*"]
    },
    "baseUrl": "."
  }
}
