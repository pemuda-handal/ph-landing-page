---
import AboutImg from "@assets/images/about-img.png";
import QuestionMark from "@assets/images/question-mark.svg";
import Rocket from "@assets/images/rocket.svg";
---

<section
  class="flex flex-col w-full gap-20 px-5 pb-10 max-w-screen-xl min-h-screen lg:px-10 xl:px-0 xl:mx-auto"
  id="about"
>
  <div
    class="pt-20 md:pt-24 flex flex-col lg:flex-row-reverse gap-4 lg:items-center lg:justify-center"
  >
    <div class="flex lg:flex-1">
      <h2
        class="text-2xl text-center lg:text-left md:text-3xl xl:text-4xl xl:pr-20 xl:leading-snug font-bold"
      >
        Menghemat waktu dengan membuat dunia <span class="text-primary"
          >lebih produktif</span
        >
      </h2>
    </div>

    <div class="flex lg:flex-1 items-center justify-center">
      <img
        src={AboutImg.src}
        alt="Handshake Image"
        class="w-3/4 md:w-1/2 lg:w-3/4"
      />
    </div>
  </div>

  <div class="flex flex-col gap-20 md:flex-row">
    <div class="flex md:flex-1 flex-col gap-2">
      <div
        class="flex gap-4 items-center justify-center font-bold md:text-lg lg:justify-start"
      >
        <img src={QuestionMark.src} alt="" class="w-6 h-6" />Siapa Kami ?
      </div>
      <p class="text-center text-sm md:text-base lg:text-left">
        Pemuda Handal adalah perusahaan yang bergerak di bidang teknologi
        digital yang menyediakan berbagai solusi digital untuk meningkatkan
        efisiensi, memperkuat strategi pemasaran, dan mendorong pertumbuhan
        bisnis klien kami.
      </p>
    </div>

    <div class="flex md:flex-1 flex-col gap-2">
      <div
        class="flex gap-4 items-center justify-center font-bold md:text-lg lg:justify-start"
      >
        <img src={Rocket.src} alt="" class="w-6 h-6" />Visi Kami
      </div>
      <p class="text-center text-sm md:text-base lg:text-left">
        Menjadi mitra terpercaya dalam transformasi digital yang memberdayakan
        bisnis untuk tumbuh dan berkembang, dengan mengedepankan nilai
        kekeluargaan dan profesionalisme.
      </p>
    </div>
  </div>
</section>
