---
import { useTranslations } from "astro-nanointl";

const locale = (Astro.currentLocale || "id") as "id" | "en";
const { translations } = await import(
  `../locales/${locale}/sections/ConnectSection.ts`
);

const t = useTranslations(
  {
    badge: "SIAP MULAI?",
    h2: "Siap Mewujudkan Ide Digital & Melejitkan Bisnis Anda?",
    subtitle:
      "Diskusikan kebutuhan Anda bersama tim ahli kami. Kami siap memberikan konsultasi teknis gratis dan estimasi roadmap solusi terbaik.",
    cta: "Konsultasi via WhatsApp",
    ctaEmail: "Kirim Email Briefing",
    responseBadge: "⚡ Rata-rata respon < 15 menit (Jam Kerja)",
  },
  {
    data: translations,
    locale,
  }
);
---

<section class="relative py-16 sm:py-24 overflow-hidden" id="contact">
  <div class="max-w-screen-xl mx-auto px-5 lg:px-10 xl:px-8">
    <div
      class="relative rounded-[2.5rem] bg-gradient-to-br from-primary via-[#6030ea] to-tertiary p-8 sm:p-12 lg:p-16 text-white overflow-hidden shadow-2xl flex flex-col items-center text-center gap-8"
    >
      <!-- Background Ambient Orbs & Grid -->
      <div class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-24 w-96 h-96 bg-secondary/30 rounded-full blur-3xl"></div>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/15 backdrop-blur-md text-white text-xs font-bold uppercase tracking-wider border border-white/20">
        <span>🚀</span>
        <span>{t.badge}</span>
      </div>

      <!-- Heading -->
      <h2
        class="text-2xl sm:text-4xl lg:text-5xl font-extrabold max-w-3xl leading-tight text-white tracking-tight"
        set:html={t.h2}
      />

      <!-- Subtitle -->
      <p class="text-white/80 text-sm sm:text-base lg:text-lg max-w-2xl leading-relaxed">
        {t.subtitle}
      </p>

      <!-- Response Badge -->
      <div class="text-xs font-semibold text-emerald-300 bg-emerald-950/40 border border-emerald-400/30 px-3.5 py-1.5 rounded-full backdrop-blur-sm">
        {t.responseBadge}
      </div>

      <!-- Dual Actions -->
      <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto pt-2">
        <a
          href="https://api.whatsapp.com/send/?phone=6285156353319&text=Halo%20Pemuda%20Handal%2C%20saya%20ingin%20konsultasi%20mengenai%20proyek%20digital.&type=phone_number&app_absent=0"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-white text-primary font-extrabold text-base shadow-xl hover:bg-slate-100 hover:shadow-2xl hover:scale-105 active:scale-95 transition-all duration-200"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 fill-current"
            viewBox="0 0 24 24"
          >
            <path
              d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91c0-2.65-1.03-5.14-2.9-7.01m-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18l-3.12.82l.83-3.04l-.2-.31a8.264 8.264 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24c2.2 0 4.27.86 5.82 2.42a8.183 8.183 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23m4.52-6.16c-.25-.12-1.47-.72-1.69-.81c-.23-.08-.39-.12-.56.12c-.17.25-.64.81-.78.97c-.14.17-.29.19-.54.06c-.25-.12-1.05-.39-1.99-1.23c-.74-.66-1.23-1.47-1.38-1.72c-.14-.25-.02-.38.11-.51c.11-.11.25-.29.37-.43s.17-.25.25-.41c.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31c-.22.25-.86.85-.86 2.07c0 1.22.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74c.59.26 1.05.41 1.41.52c.59.19 1.13.16 1.56.1c.48-.07 1.47-.6 1.67-1.18c.21-.58.21-1.07.14-1.18s-.22-.16-.47-.28"
            />
          </svg>
          <span>{t.cta}</span>
        </a>

        <a
          href="mailto:pemudahandal.id@gmail.com"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-white/10 hover:bg-white/20 border border-white/30 text-white font-bold text-base backdrop-blur-md transition-all duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{t.ctaEmail}</span>
        </a>
      </div>
    </div>
  </div>
</section>
