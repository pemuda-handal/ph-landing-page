---
import HeroImage from "@assets/images/hero-img.png";
import { useTranslations } from "astro-nanointl";

const locale = Astro.currentLocale || "id";
const { translations } = await import(
  `../locales/${locale}/sections/HeroSection.ts`
);

const t = useTranslations(
  {
    badge: "✨ Solusi Digital & Inovasi 360° Terpercaya",
    h1: 'Jelajahi <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-secondary to-primary">Masa Depan Digital</span> Bersama <span class="text-primary">Pemuda Handal</span>',
    p: "Mitra teknologi profesional untuk pengembangan website modern, aplikasi web & mobile kustom, serta pengalaman virtual 360° yang mendorong pertumbuhan bisnis Anda.",
    cta: "Lihat Portofolio",
    ctaSecondary: "Hitung Estimasi Biaya",
    stat1Value: "50+",
    stat1Label: "Proyek Sukses",
    stat2Value: "99.8%",
    stat2Label: "Kepuasan Klien",
    stat3Value: "24/7",
    stat3Label: "Dukungan Responsif",
    floatBadge1: "⚡ Modern & Ultra Cepat",
    floatBadge2: "🌐 360° Virtual Tour",
    floatBadge3: "📱 Multi-Platform App",
  },
  {
    data: translations,
    locale: locale,
  }
);
---

<section
  class="relative overflow-hidden pt-28 pb-16 lg:pt-36 lg:pb-24 min-h-[92vh] flex items-center"
>
  <!-- Ambient background glow & patterns -->
  <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-gradient-to-tr from-primary/20 to-secondary/15 rounded-full blur-3xl opacity-70"></div>
  <div class="pointer-events-none absolute top-1/3 -left-32 w-80 h-80 bg-primary/10 rounded-full blur-2xl"></div>
  <div class="pointer-events-none absolute bottom-10 -right-20 w-96 h-96 bg-secondary/15 rounded-full blur-3xl"></div>

  <!-- Subtle dot pattern overlay -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(#e0e7ff_1px,transparent_1px)] [background-size:24px_24px] opacity-40"></div>

  <div class="relative max-w-screen-xl mx-auto px-5 lg:px-10 xl:px-8 w-full z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Text column -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left gap-6">
        
        <!-- Interactive Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/80 backdrop-blur-md border border-primary/20 shadow-sm hover:border-primary/50 transition-all duration-300 hover:shadow-card cursor-default group">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-primary"></span>
          </span>
          <span class="text-xs sm:text-sm font-semibold text-slate-800 tracking-wide group-hover:text-primary transition-colors">
            {t.badge}
          </span>
        </div>

        <!-- Headline -->
        <h1
          class="font-extrabold text-3xl sm:text-4xl md:text-5xl xl:text-6xl text-slate-900 leading-[1.15] sm:leading-[1.15] tracking-tight"
          set:html={t.h1}
        />

        <!-- Paragraph Description -->
        <p class="text-slate-600 text-base sm:text-lg lg:text-xl max-w-2xl leading-relaxed">
          {t.p}
        </p>

        <!-- Interactive Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto pt-2">
          <a
            href="#portfolio"
            class="group w-full sm:w-auto inline-flex items-center justify-center gap-3 px-7 py-3.5 rounded-full bg-primary text-white font-bold text-base shadow-lg shadow-primary/25 hover:shadow-glow hover:bg-secondary hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
          >
            <span>{t.cta}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="#estimator"
            class="group w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-full bg-white/90 backdrop-blur-sm text-slate-800 font-bold text-base border border-slate-200 hover:border-primary/50 hover:text-primary hover:bg-white shadow-sm hover:shadow-card hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
          >
            <span class="text-lg">⚡</span>
            <span>{t.ctaSecondary}</span>
          </a>
        </div>

        <!-- Social Proof & Stats Counters -->
        <div class="grid grid-cols-3 gap-4 sm:gap-8 pt-6 sm:pt-8 border-t border-slate-200/80 w-full max-w-lg">
          <div class="flex flex-col items-center lg:items-start group cursor-default">
            <span class="text-2xl sm:text-3xl font-extrabold text-primary group-hover:scale-105 transition-transform">
              {t.stat1Value}
            </span>
            <span class="text-xs sm:text-sm text-slate-500 font-medium">
              {t.stat1Label}
            </span>
          </div>

          <div class="flex flex-col items-center lg:items-start group cursor-default">
            <span class="text-2xl sm:text-3xl font-extrabold text-primary group-hover:scale-105 transition-transform">
              {t.stat2Value}
            </span>
            <span class="text-xs sm:text-sm text-slate-500 font-medium">
              {t.stat2Label}
            </span>
          </div>

          <div class="flex flex-col items-center lg:items-start group cursor-default">
            <span class="text-2xl sm:text-3xl font-extrabold text-primary group-hover:scale-105 transition-transform">
              {t.stat3Value}
            </span>
            <span class="text-xs sm:text-sm text-slate-500 font-medium">
              {t.stat3Label}
            </span>
          </div>
        </div>

      </div>

      <!-- Visual Graphic Column with Interactive Floating Badges -->
      <div class="lg:col-span-5 relative flex items-center justify-center">
        <!-- Center glowing halo -->
        <div class="absolute w-72 h-72 sm:w-96 sm:h-96 rounded-full bg-gradient-to-tr from-primary/30 to-secondary/20 blur-2xl -z-10 animate-pulse-slow"></div>

        <!-- Main Rocket Illustration -->
        <div class="relative w-full max-w-md lg:max-w-none flex items-center justify-center">
          <img
            src={HeroImage.src}
            alt="Pemuda Handal Digital Rocket"
            class="w-4/5 max-w-[340px] lg:max-w-[420px] h-auto object-contain scale-x-[-1] animate-float drop-shadow-2xl select-none"
          />

          <!-- Floating Badge 1 (Top Left) -->
          <div
            class="absolute -top-4 sm:-top-6 left-2 sm:-left-4 bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-slate-100 shadow-card animate-float hover:scale-105 hover:shadow-card-hover transition-all duration-300 flex items-center gap-2.5 z-20 cursor-pointer"
          >
            <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center text-sm font-bold shadow-sm">
              ⚡
            </div>
            <div class="text-left">
              <p class="text-xs font-bold text-slate-800">{t.floatBadge1}</p>
              <p class="text-[10px] text-slate-400 font-medium">Next-gen Tech</p>
            </div>
          </div>

          <!-- Floating Badge 2 (Bottom Right) -->
          <div
            class="absolute top-1/2 -right-2 sm:-right-6 bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-slate-100 shadow-card animate-float-delayed hover:scale-105 hover:shadow-card-hover transition-all duration-300 flex items-center gap-2.5 z-20 cursor-pointer"
          >
            <div class="w-8 h-8 rounded-xl bg-purple-50 text-primary flex items-center justify-center text-sm font-bold shadow-sm">
              🌐
            </div>
            <div class="text-left">
              <p class="text-xs font-bold text-slate-800">{t.floatBadge2}</p>
              <p class="text-[10px] text-slate-400 font-medium">Immersive 3D Tour</p>
            </div>
          </div>

          <!-- Floating Badge 3 (Bottom Center) -->
          <div
            class="absolute -bottom-6 left-8 sm:left-12 bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-slate-100 shadow-card animate-float hover:scale-105 hover:shadow-card-hover transition-all duration-300 flex items-center gap-2.5 z-20 cursor-pointer"
          >
            <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm font-bold shadow-sm">
              📱
            </div>
            <div class="text-left">
              <p class="text-xs font-bold text-slate-800">{t.floatBadge3}</p>
              <p class="text-[10px] text-slate-400 font-medium">Web & Mobile</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
