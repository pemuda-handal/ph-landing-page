---
import ButtonComponent from "../components/ButtonComponent.astro";
import HeroImage from "../../public/hero-img.png";
---

<section
  class="flex flex-col px-5 py-10 lg:py-28 lg:px-20 max-w-screen-xl xl:px-0 xl:mx-auto items-center justify-center gap-5"
>
  <div class="flex flex-col-reverse items-center px-5 md:flex-row lg:px-16">
    <div class="flex flex-col gap-20 md:items-start flex-1">
      <div class="flex flex-col gap-5">
        <p class="font-bold text-2xl lg:text-3xl xl:text-5xl lg:w-full">
          Jelajahi <span class="text-primary"> Masa Depan </span>Digital
          <br />
          dengan <span class="text-primary">Pemuda Handal</span>
        </p>
        <p class="text-quartenary">
          Solusi SaaS Terpercaya dan Profesional untuk Transformasi Digital Anda
        </p>
      </div>
      <ButtonComponent
        customClass="w-full justify-center lg:w-auto"
        title="Jadwalkan Demo"
        ><svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 512 512"
          ><path
            fill="currentColor"
            d="M480 128a64 64 0 0 0-64-64h-16V48.45c0-8.61-6.62-16-15.23-16.43A16 16 0 0 0 368 48v16H144V48.45c0-8.61-6.62-16-15.23-16.43A16 16 0 0 0 112 48v16H96a64 64 0 0 0-64 64v12a4 4 0 0 0 4 4h440a4 4 0 0 0 4-4ZM32 416a64 64 0 0 0 64 64h320a64 64 0 0 0 64-64V179a3 3 0 0 0-3-3H35a3 3 0 0 0-3 3Zm344-208a24 24 0 1 1-24 24a24 24 0 0 1 24-24m0 80a24 24 0 1 1-24 24a24 24 0 0 1 24-24m-80-80a24 24 0 1 1-24 24a24 24 0 0 1 24-24m0 80a24 24 0 1 1-24 24a24 24 0 0 1 24-24m0 80a24 24 0 1 1-24 24a24 24 0 0 1 24-24m-80-80a24 24 0 1 1-24 24a24 24 0 0 1 24-24m0 80a24 24 0 1 1-24 24a24 24 0 0 1 24-24m-80-80a24 24 0 1 1-24 24a24 24 0 0 1 24-24m0 80a24 24 0 1 1-24 24a24 24 0 0 1 24-24"
          ></path></svg
        ></ButtonComponent
      >
    </div>
    <div class="flex-1 lg:w-2/5 lg:flex-none flex justify-center">
      <img src={HeroImage.src} alt="" class="img-hero scale-x-[-1]" />
    </div>
  </div>

  <style>
    .img-hero {
      animation: rocketMove 3s infinite;
    }
    @keyframes rocketMove {
      0% {
        transform: translate(0, 0) scaleX(-1);
      }
      50% {
        transform: translate(10px, -20px) scaleX(-1);
      }
      100% {
        transform: translate(0, 0) scaleX(-1);
      }
    }
  </style>
</section>
