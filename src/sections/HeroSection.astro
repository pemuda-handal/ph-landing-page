---
import HeroImage from "@assets/images/hero-img.png";
import { useTranslations } from "astro-nanointl";
import Button from "../components/ButtonComponent.astro";

const locale = Astro.currentLocale || "id";
const { translations } = await import(
  `../locales/${locale}/sections/HeroSection.ts`
);

const t = useTranslations(
  {
    h1: 'Jelajahi <span class="text-primary">Masa Depan</span> Digital <br /> dengan <span class="text-primary">Pemuda Handal</span>',
    p: "Mitra Teknologi Profesional Terbaik dan Terpercaya untuk Transformasi Digital Anda",
    cta: "Lihat Portofolio",
  },
  {
    data: translations,
    locale: locale,
  }
);
---

<section
  class="flex flex-col px-5 pb-10 pt-16 lg:pt-20 max-w-screen-xl xl:px-0 xl:mx-auto items-center justify-center gap-5 h-screen -mt-16 lg:-mt-20 lg:px-10"
>
  <div
    class="flex flex-col-reverse items-center justify-between h-full w-full md:flex-row pt-16 lg:pt-20 gap-5 md:gap-0"
  >
    <div class="flex flex-col gap-20 md:items-start md:flex-1 w-full md:w-auto">
      <div class="flex flex-col gap-5">
        <h1
          class="font-bold text-2xl md:leading-snug xl:leading-snug md:text-3xl xl:text-5xl md:w-full"
          set:html={t.h1}
        />

        <p class="text-quartenary xl:text-lg" set:html={t.p} />
      </div>

      <Button customClass="w-full justify-center md:w-auto" href="#portfolio">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          ><path
            fill="currentColor"
            d="M8 13h8v-2H8zm0 3h8v-2H8zm0 3h5v-2H8zm-2 3q-.825 0-1.412-.587T4 20V4q0-.825.588-1.412T6 2h8l6 6v12q0 .825-.587 1.413T18 22zm7-13h5l-5-5z"
          ></path></svg
        >
        {t.cta}
      </Button>
    </div>

    <img
      src={HeroImage.src}
      alt="hero-image"
      class="grow object-cover md:grow-0 h-0 md:h-auto md:w-2/5 lg:object-contain lg:w-auto lg:max-w-[40%] lg:h-full img-hero scale-x-[-1]"
    />
  </div>
</section>

<style>
  .img-hero {
    animation: rocketMove 3s infinite;
  }

  @keyframes rocketMove {
    0% {
      transform: translate(0, 0) scaleX(-1);
    }

    50% {
      transform: translate(10px, -20px) scaleX(-1);
    }

    100% {
      transform: translate(0, 0) scaleX(-1);
    }
  }
</style>
