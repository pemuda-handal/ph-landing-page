---
import FaqSectionComponent from "@components/FaqSection.svelte";

interface Props {
  locale?: string;
}

const { locale = Astro.currentLocale || "id" } = Astro.props;
const currentLocale = (locale || "id") as "id" | "en";

const badge = currentLocale === "en" ? "FAQ & GUIDANCE" : "FAQ & PANDUAN LENGKAP";
const h2 = currentLocale === "en"
  ? 'Frequently Asked <span class="text-primary">Questions</span>'
  : 'Pertanyaan yang Sering <span class="text-primary">Diajukan</span>';
const subtitle = currentLocale === "en"
  ? "Find fast, clear answers regarding our project workflows, pricing models, warranties, and VR capabilities."
  : "Temukan jawaban jelas dan transparan seputar alur kerja, estimasi biaya, garansi, dan teknologi kami.";
---

<section
  class="relative py-20 lg:py-28 max-w-screen-xl mx-auto px-5 lg:px-10 xl:px-8"
  id="faq"
>
  <!-- Background Glow -->
  <div class="pointer-events-none absolute right-10 top-1/2 w-80 h-80 bg-primary/5 rounded-full blur-3xl"></div>

  <!-- Header -->
  <div class="flex flex-col items-center text-center gap-4 mb-12 max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider">
      <span>❓</span>
      <span>{badge}</span>
    </div>

    <h2
      class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-extrabold text-slate-900 leading-tight"
      set:html={h2}
    />

    <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
      {subtitle}
    </p>
  </div>

  <!-- Interactive FAQ Accordion -->
  <FaqSectionComponent client:visible locale={currentLocale} />
</section>
