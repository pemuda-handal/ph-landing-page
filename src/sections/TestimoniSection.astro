---
import TestimoniCardComponent from "../components/TestimoniCardComponent.astro";
import ButtonComponent from "../components/ButtonComponent.astro";

const testimoniList = [
  {
    title: "Mudah Berkembang",
    author: "Ojeb",
    company: "Pemuda Handal",
    description:
      "Cukup Membantu UMKM yang ada Cukup Membantu UMKM yang ada Cukup Membantu UMKM yang adaCukup Membantu UMKM yang adaCukup Membantu UMKM yang ada",
    stars: 5,
  },
  {
    title: "Cukup Membantu",
    author: "Roni",
    company: "Pemuda Handal",
    description:
      "Cukup Membantu UMKM yang ada Cukup Membantu UMKM yang ada Cukup Membantu UMKM yang ada Cukup Membantu UMKM yang adaCukup Membantu UMKM yang adaCukup Membantu UMKM yang adaCukup Membantu UMKM yang adaCukup Membantu UMKM yang adaCukup Membantu UMKM yang adaCukup Membantu UMKM yang adaCukup Membantu UMKM yang ada",
    stars: 4,
  },
  {
    title: "Sangat Bermanfaat",
    author: "Bambang",
    company: "Pemuda Handal",
    description:
      "Cukup Membantu UMKM yang ada Cukup Membantu UMKM yang adaCukup Membantu UMKM yang ada  Cukup Membantu UMKM yang adaCukup Membantu UMKM yang ada",
    stars: 4,
  },
];
---

<section class="bg-primary">
  <div
    class="flex flex-col max-w-screen-xl mx-auto py-20 lg:py-20 lg:px-20 xl:px-0 gap-20 lg:gap-32"
  >
    <p
      class="title text-white font-bold text-2xl text-center px-4 lg:px-0 lg:text-5xl"
    >
      Apa Kata Mereka?
    </p>

    <div>
      <div
        class="card flex flex-row px-4 gap-5 lg:px-0 lg:gap-8 lg:w-full overflow-auto"
      >
        {
          testimoniList.map((data, index) => {
            if (index % 2 === 0) {
              return (
                <div class="min-w-full sm:min-w-min sm:flex-1 lg:mt-40">
                  <TestimoniCardComponent
                    author={data.author}
                    title={data.title}
                    description={data.description}
                    company={data.company}
                    stars={data.stars}
                  />
                </div>
              );
            } else {
              return (
                <div class="min-w-full sm:min-w-min sm:flex-1 lg:mb-40">
                  <TestimoniCardComponent
                    author={data.author}
                    title={data.title}
                    description={data.description}
                    company={data.company}
                    stars={data.stars}
                  />
                </div>
              );
            }
          })
        }
      </div>

      <div
        class="flex flex-row gap-5 w-full justify-center items-center pt-10 lg:hidden"
      >
        <button class="bg-white p-1 rounded-full"></button>
        <button class="bg-white p-1 w-1/3 rounded-full"></button>
        <button class="bg-white p-1 rounded-full"></button>
      </div>
    </div>
  </div>
</section>

<style>
  .title {
    animation: moveTitle 3s ease-in-out;
  }
  .card {
    animation: moveCard 3s ease-out;
  }
  .contact {
    animation: moveContact 3s ease-out;
  }

  @keyframes moveTitle {
    0% {
      transform: translateX(100%);
      color: #7241ff;
    }
    50% {
      transform: translateX(-50%);
      color: #7b78ff;
    }
    100% {
      transform: translateX(0%);
      color: #353879;
    }
  }

  @keyframes moveCard {
    0% {
      transform: translateX(100%);
    }
    50% {
      transform: translateX(0%);
    }
    75% {
      transform: translateX(10%);
      color: #353879;
    }
    100% {
      transform: translateX(0%);
    }
  }

  @keyframes moveContact {
    0% {
      transform: translateX(100%);
    }
    50% {
      transform: translateX(10%);
    }
    75% {
      transform: translateX(-10%);
    }
    100% {
      transform: translateX(0%);
    }
  }
</style>
