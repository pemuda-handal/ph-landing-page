---
import Card from "../components/CardComponent.astro";
import ProjectGTA from "@assets/images/projects/project-gta.png";
import ProjectSigmund from "@assets/images/projects/project-sigmund.png";
import ProjectPouchpack from "@assets/images/projects/project-pouchpack.png";
import ProjectABS from "@assets/images/projects/project-abs.png";
import ProjectJagoTernak from "@assets/images/projects/project-jagoternak.png";

const cardItems = [
  {
    title: "GTA V Role Play Server: Five Project Indonesia Landing Page",
    detail:
      "Kami mengembangkan landing website sebagai sarana promosi dan penyampaian informasi server GTA V Roleplay",
    image: ProjectGTA,
    link: "https://google.com",
  },
  {
    title: "Branding Agency: Sigmund Creatus Landing Page",
    detail:
      "Klien kami Sigmund Creatus membutuhkan website landing page sebagai sarana promosi dan penyampaian informasi berkaitan dengan jasa mereka dalam membantu branding suatu bisnis.",
    image: ProjectSigmund,
    link: "https://google.com",
  },
  {
    title: "Garment Business: PouchPack Landing Page",
    detail:
      "Klien kami PouchPack membutuhkan website landing page sebagai sarana promosi dan penyampaian informasi berkaitan dengan penjualan Pouch Custom seperti Packaging, Event, Souvenir, etc.",
    image: ProjectPouchpack,
    link: "https://google.com",
  },
  {
    title: "Book Store: Altasha Book Store Inventory App",
    detail:
      "Klien kami Altasha merupakan sebuah toko buku online membutuhkan manajemen inventaris untuk pengelolaan buku dan akuntansi penjualan & pembelian buku.",
    image: ProjectABS,
    link: "https://google.com",
  },
  {
    title: "Poultry Startup: Jago Ternak Monitoring App",
    detail:
      "Klien kami Jago Ternak merupakan startup di industri peternakan yang saat ini fokus dalam mengembangkan industri peternakan ayam kampung. Jago Ternak membutuhkan website landing page sekaligus website manajemen peternakan yang meliputi dashboard, pelaporan, dan laman edukasi bagi mitra Jago Ternak.",
    image: ProjectJagoTernak,
    link: "https://google.com",
  },
];
---

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("#portfolio button.read-more").forEach((el) => {
      el.addEventListener("click", () => {
        el.parentElement
          ?.querySelector(".card-detail")
          ?.classList.remove("line-clamp-4");
      });
    });
  });
</script>

<section
  class="flex flex-col gap-10 px-5 pb-10 max-w-screen-xl lg:px-10 xl:px-0 xl:mx-auto md:min-h-screen"
  id="portfolio"
>
  <h2
    class="text-2xl pt-20 md:pt-24 md:text-3xl xl:text-4xl font-bold max-w-screen-xl"
  >
    Studi Kasus Kami
  </h2>

  <div
    class="flex overflow-auto px-10 pb-10 -mx-10 -mb-10 md:grid md:grid-cols-2 lg:grid-cols-3 gap-5 xl:gap-10"
  >
    {
      cardItems.map((item) => (
        <Card
          title={item.title}
          detail={item.detail}
          image={item.image}
          customClass="shrink-0 w-80 md:w-auto"
          size="lg"
        />
      ))
    }
  </div>
</section>
