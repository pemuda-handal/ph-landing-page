---
import Destination from "@assets/images/destination.svg";
import Hotel from "@assets/images/hotel.svg";
import Meteor from "@assets/images/meteor.png";
import Museum from "@assets/images/museum.svg";
import Perumahan from "@assets/images/perumahan.svg";
import ProductLanding from "@assets/images/products/product-landing.png";
import ProductMobileApp from "@assets/images/products/product-mobile-app.png";
import ProductUIDesign from "@assets/images/products/product-ui-ux-design.png";
import ProductVintero from "@assets/images/products/product-vintero.png";
import ProductWebApp from "@assets/images/products/product-web-app.png";
import Restaurant from "@assets/images/restaurant.svg";
import CardComponent from "@components/CardComponent.astro";
import ChipComponent from "@components/ChipComponent.astro";
import { useTranslations } from "astro-nanointl";

const locale = Astro.currentLocale || "id";
const { translations } = await import(
  `../locales/${locale}/sections/ProductServiceSection.ts`
);

const t = useTranslations(
  {
    h2: 'Menghemat waktu dengan membuat dunia <span class="text-primary">lebih produktif</span>',
    cardMore: "Baca Selengkapnya",
  },
  {
    data: translations,
    locale,
  }
);

const chipComponents: {
  name: { [key: string]: string };
  svg: ImageMetadata;
}[] = [
  {
    name: { id: "Perumahan", en: "Residence" },
    svg: Perumahan,
  },
  {
    name: { id: "Hotel", en: "Hotel" },
    svg: Hotel,
  },
  {
    name: { id: "Restoran", en: "Restaurant" },
    svg: Restaurant,
  },
  {
    name: { id: "Museum", en: "Museum" },
    svg: Museum,
  },
  {
    name: { id: "Destinasi Wisata", en: "Tourist Destination" },
    svg: Destination,
  },
];

const services: {
  title: { [key: string]: string };
  detail: { [key: string]: string };
  image: ImageMetadata;
  titleLink?: { [key: string]: string };
  link?: string;
}[] = [
  {
    title: { id: "VinteroVR", en: "VinteroVR" },
    detail: {
      id: "Solusi terbaik untuk pemasaran properti Anda. Dengan teknologi 360° Virtual Tour, Anda dapat menampilkan properti Anda dengan lebih interaktif dan menarik.",
      en: "The best solution for your property marketing. With 360° Virtual Tour technology, you can showcase your property in a more interactive and attractive way.",
    },
    image: ProductVintero,
    link: "https://vinterovr.com",
    titleLink: { id: "Pelajari", en: "Learn More" },
  },
  {
    title: { id: "Landing Page", en: "Landing Page" },
    detail: {
      id: "Maksimalkan kesan pertama bisnis Anda melalui landing page yang dirancang secara profesional, dengan fokus pada estetika dan efektivitas konversi.",
      en: "Maximize the first impression of your business through a professionally designed landing page, focusing on aesthetics and conversion effectiveness.",
    },
    image: ProductLanding,
  },
  {
    title: { id: "Aplikasi Web", en: "Web Application" },
    detail: {
      id: "Kami menciptakan aplikasi web yang tidak hanya terlihat menarik, tetapi juga mampu mendukung kebutuhan operasional dan efisiensi bisnis Anda.",
      en: "We create web applications that not only look good, but are also able to support the operational needs and efficiency of your business.",
    },
    image: ProductWebApp,
  },
  {
    title: { id: "Aplikasi Mobile", en: "Mobile Application" },
    detail: {
      id: "Raih audiens yang lebih luas melalui aplikasi mobile yang dirancang khusus untuk perangkat Android dan iOS, dengan performa tinggi dan fitur yang relevan",
      en: "Reach a wider audience through mobile apps designed specifically for Android and iOS devices, with high performance and relevant features.",
    },
    image: ProductMobileApp,
  },
  {
    title: { id: "UI/UX Design", en: "UI/UX Design" },
    detail: {
      id: "Tingkatkan pengalaman pengguna dengan desain UI/UX yang elegan, intuitif, dan berorientasi pada kenyamanan pelanggan",
      en: "Enhance user experience with elegant, intuitive, and customer-centric UI/UX design",
    },
    image: ProductUIDesign,
  },
  {
    title: { id: "Maintenance", en: "Maintenance" },
    detail: {
      id: "Pastikan sistem digital Anda tetap optimal dan up-to-date. Kami menawarkan layanan maintenance jika Anda butuh melakukan pembaruan terhadap sistem digital yang telah Anda bangun.",
      en: "Keep your digital system optimized and up-to-date. We offer maintenance services if you need to update the digital system you have built.",
    },
    image: ProductWebApp,
  },
];
---

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("#product button.read-more").forEach((el) => {
      el.addEventListener("click", () => {
        el.parentElement
          ?.querySelector(".card-detail")
          ?.classList.remove("line-clamp-4");
      });
    });

    document
      .querySelector("#product .card-container")
      ?.addEventListener("scroll", (e) => {
        const targetEl = e.target as HTMLDivElement;

        const isLeftEnd = targetEl.scrollLeft === 0;

        if (isLeftEnd) {
          document
            .querySelector("#product button.prev")
            ?.classList.add("opacity-0");
        } else {
          document
            .querySelector("#product button.prev")
            ?.classList.remove("opacity-0");
        }

        const isRightEnd =
          targetEl.scrollWidth - targetEl.scrollLeft === targetEl.clientWidth;

        if (isRightEnd) {
          document
            .querySelector("#product button.next")
            ?.classList.add("opacity-0");
        } else {
          document
            .querySelector("#product button.next")
            ?.classList.remove("opacity-0");
        }
      });
  });
</script>

<script is:inline>
  function productScrollRight() {
    document.querySelector("#product .card-container")?.scrollBy(360, 0);
  }

  function productScrollLeft() {
    document.querySelector("#product .card-container")?.scrollBy(-360, 0);
  }
</script>

<section
  class="px-5 pb-20 min-h-screen flex items-center lg:py-20 max-w-screen-xl lg:px-10 xl:px-0 xl:mx-auto"
  id="product"
>
  <div
    class="flex flex-col items-center w-full gap-20 lg:flex-row lg:items-stretch"
  >
    <div
      class="product pt-20 md:pt-24 lg:pt-0 flex flex-col items-center gap-10 flex-1 lg:justify-between lg:items-start"
    >
      <img src={Meteor.src} alt="meteor" class="flex-1" />

      <div class="flex flex-col items-center gap-5 lg:gap-10 lg:items-start">
        <h2
          class="font-bold text-2xl md:text-3xl xl:text-4xl xl:leading-snug"
          set:html={t.h2}
        />

        <div
          class="flex flex-row gap-x-2 gap-y-4 flex-wrap justify-center lg:justify-start"
        >
          {
            chipComponents.map((data) => {
              return (
                <ChipComponent name={data.name[locale]} emote={data.svg} />
              );
            })
          }
        </div>
      </div>
    </div>

    <div class="relative lg:w-1/2 flex">
      <button
        class="prev hidden absolute opacity-0 transition-opacity -left-10 top-1/2 -translate-y-1/2 bg-primary text-white h-12 w-12 lg:flex items-center justify-center rounded-full z-20"
        onclick="productScrollLeft()"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          class="w-8 h-8"
          ><path
            fill="currentColor"
            d="m14 18l-6-6l6-6l1.4 1.4l-4.6 4.6l4.6 4.6z"></path></svg
        >
      </button>

      <div
        class="card-container flex flex-col gap-5 xl:gap-10 sm:grid sm:grid-cols-2 lg:flex lg:flex-row lg:overflow-auto px-10 scroll-px-5 -mx-10 py-5 -my-5 -mb-10 pb-10 scroll-smooth snap-x"
      >
        {
          services.map((data) => {
            return (
              <CardComponent
                title={data.title[locale]}
                detail={data.detail[locale]}
                image={data.image}
                link={data.link}
                customClass="min-w-[60%] snap-start snap-normal"
                titleLink={data.titleLink ? data.titleLink[locale] : t.cardMore}
                size="xl"
              />
            );
          })
        }
      </div>

      <button
        class="next hidden absolute transition-opacity -right-4 2xl:-right-16 top-1/2 -translate-y-1/2 bg-primary text-white h-12 w-12 lg:flex items-center justify-center rounded-full z-20"
        onclick="productScrollRight()"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          class="w-8 h-8"
          ><path fill="currentColor" d="M12.6 12L8 7.4L9.4 6l6 6l-6 6L8 16.6z"
          ></path></svg
        >
      </button>
    </div>
  </div>
</section>

<style>
  .product {
    /* animation: productMove 2s ease-in; */
  }

  .card-container::-webkit-scrollbar {
    display: none;
  }

  .card-container {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none;
    /* position: relative; */
    /* animation: cardMove 2s ease-in; */
  }

  @keyframes productMove {
    0% {
      transform: translate(200%, -3%);
      color: #7241ff;
    }
    50% {
      transform: translateX(-10%);
      color: #7b78ff;
    }
    100% {
      transform: translateX(0%);
      color: #353879;
    }
  }

  @keyframes cardMove {
    0% {
      transform: translate(200%, 30%);
      color: #7241ff;
    }
    50% {
      transform: translate(-10%, 10%);
      color: #7b78ff;
    }
    75% {
      transform: translateX(3%);
      color: #7b78ff;
    }
    100% {
      transform: translateX(0%);
      color: #353879;
    }
  }
</style>
