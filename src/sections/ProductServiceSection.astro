---
import Destination from "../../public/destination.svg";
import Hotel from "../../public/hotel.svg";
import Meteor from "../../public/meteor.png";
import Museum from "../../public/museum.svg";
import Perumahan from "../../public/perumahan.svg";
import Product from "../../public/product.png";
import Restaurant from "../../public/restaurant.svg";
import CardComponent from "../components/CardComponent.astro";
import ChipComponent from "../components/ChipComponent.astro";

const chipComponents = [
  {
    name: "perumahan",
    svg: Perumahan,
  },
  {
    name: "hotel",
    svg: Hotel,
  },
  {
    name: "Restauran",
    svg: Restaurant,
  },
  {
    name: "Museum",
    svg: Museum,
  },
  {
    name: "Destinasi Wisata",
    svg: Destination,
  },
];

const services = [
  {
    title: "Kemudahan Publikasi",
    detail: "lorem",
    image: Product,
    link: "www.google.com",
    titleLink: "Selengkapnya",
  },
  {
    title: "Kemudahan Publikasi",
    detail: "",
    image: Product,
    link: "www.google.com",
    titleLink: "Selengkapnya",
  },
  {
    title: "Kemudahan Publikasi",
    detail: "",
    image: Product,
    link: "www.google.com",
    titleLink: "Selengkapnya",
  },
  {
    title: "Kemudahan Publikasi",
    detail: "",
    image: Product,
    link: "www.google.com",
    titleLink: "Selengkapnya",
  },
  {
    title: "Kemudahan Publikasi",
    detail: "",
    image: Product,
    link: "www.google.com",
    titleLink: "Selengkapnya",
  },
  {
    title: "Kemudahan Publikasi",
    detail: "",
    image: Product,
    link: "www.google.com",
    titleLink: "Selengkapnya",
  },
  {
    title: "Kemudahan Publikasi",
    detail: "",
    image: Product,
    link: "www.google.com",
    titleLink: "Selengkapnya",
  },
];
---

<div
  class="px-5 flex flex-col items-center w-full gap-20 lg:flex-row lg:items-stretch max-w-screen-xl xl:px-0 mx-auto"
>
  <div
    class="product flex flex-col items-center gap-20 flex-1 lg:justify-between lg:items-start"
  >
    <img src={Meteor.src} alt="" class="flex-1" />

    <div class="flex flex-col items-center gap-5 lg:gap-10 lg:items-start">
      <p class="font-bold text-2xl lg:text-5xl lg:leading-[78px]">
        Solusi Bisnis <br class="hidden lg:block" />Terbaik
      </p>

      <div
        class="flex flex-row gap-x-2 gap-y-4 flex-wrap justify-center lg:justify-start"
      >
        {
          chipComponents.map((data) => {
            return <ChipComponent name={data.name} emote={data.svg} />;
          })
        }
      </div>
    </div>
  </div>

  <div
    class="card-container flex flex-col gap-10 md:grid md:grid-cols-2 lg:flex lg:flex-row lg:overflow-auto lg:-mx-4 lg:w-1/2 p-4"
  >
    {
      services.map((data) => {
        return (
          <CardComponent
            title={data.title}
            detail={data.detail}
            image={data.image.src}
            link={data.link}
            customClass="min-w-[60%]"
            titleLink={data.titleLink}
            titleSize="lg"
          />
        );
      })
    }
  </div>
</div>

<style>
  .product {
    animation: productMove 2s ease-in;
  }

  .card-container::-webkit-scrollbar {
    display: none;
  }

  .card-container {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none;
    position: relative;
    animation: cardMove 2s ease-in;
  }

  @keyframes productMove {
    0% {
      transform: translate(200%, -3%);
      color: #7241ff;
    }
    50% {
      transform: translateX(-10%);
      color: #7b78ff;
    }
    100% {
      transform: translateX(0%);
      color: #353879;
    }
  }

  @keyframes cardMove {
    0% {
      transform: translate(200%, 30%);
      color: #7241ff;
    }
    50% {
      transform: translate(-10%, 10%);
      color: #7b78ff;
    }
    75% {
      transform: translateX(3%);
      color: #7b78ff;
    }
    100% {
      transform: translateX(0%);
      color: #353879;
    }
  }
</style>
