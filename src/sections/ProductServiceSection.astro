---
import ProductLanding from "@assets/images/products/product-landing.png";
import ProductMobileApp from "@assets/images/products/product-mobile-app.png";
import ProductUIDesign from "@assets/images/products/product-ui-ux-design.png";
import ProductVintero from "@assets/images/products/product-vintero.png";
import ProductWebApp from "@assets/images/products/product-web-app.png";
import ServicesShowcase from "@components/ServicesShowcase.svelte";
import { useTranslations } from "astro-nanointl";

const locale = (Astro.currentLocale || "id") as "id" | "en";
const { translations } = await import(
  `../locales/${locale}/sections/ProductServiceSection.ts`
);

const t = useTranslations(
  {
    badge: "LAYANAN & PRODUK UNGGULAN",
    h2: 'Solusi Teknologi Digital <span class="text-primary">Terlengkap & Fleksibel</span>',
    subtitle:
      "Mulai dari website berkonversi tinggi, platform web & mobile kustom, hingga pengalaman interaktif Virtual Tour 360° siap pakai.",
  },
  {
    data: translations,
    locale,
  }
);

const services = [
  {
    id: "vintero",
    title: { id: "VinteroVR (360° Virtual Tour)", en: "VinteroVR (360° Virtual Tour)" },
    badge: { id: "🔥 Inovasi Unggulan", en: "🔥 Flagship Innovation" },
    detail: {
      id: "Solusi pemasaran properti dan destinasi dengan teknologi 360° Virtual Tour interaktif. Calon pelanggan dapat menjelajahi ruang nyata dari browser atau VR headset.",
      en: "Immersive 360° Virtual Tour platform for real estate, hospitality, and destinations. Explore real spaces from any browser or VR headset.",
    },
    imageSrc: ProductVintero.src,
    features: {
      id: [
        "Fotografi & Render Panorama 360° Resolusi Tinggi",
        "Hotspot interaktif untuk info titik ruangan & video",
        "Kompatibel smartphone, tablet, desktop & VR headset",
        "Dapat di-embed langsung ke website atau Google Street View",
      ],
      en: [
        "High-definition 360° panoramic photography & render",
        "Interactive hotspots for room specs, photos & videos",
        "Fully responsive on mobile, desktop & VR headsets",
        "Effortless website embed & Google Street View sync",
      ],
    },
    externalUrl: "https://vinterovr.com",
    isVirtualReality: true,
  },
  {
    id: "landing",
    title: { id: "Landing Page Berkonversi Tinggi", en: "High-Converting Landing Pages" },
    badge: { id: "⚡ Paling Populer", en: "⚡ Most Popular" },
    detail: {
      id: "Maksimalkan penjualan dan branding dengan landing page modern yang dirancang secara strategis, loading super cepat (< 1 detik), dan terintegrasi WhatsApp.",
      en: "Maximize leads and sales with ultra-fast modern landing pages engineered with conversion copywriting and instant WhatsApp integration.",
    },
    imageSrc: ProductLanding.src,
    features: {
      id: [
        "Desain kustom unik & responsif di semua ukuran layar",
        "Optimasi Core Web Vitals & skor SEO terbaik",
        "Integrasi analitik (Google Analytics, Meta Pixel, TikTok)",
        "Formulir kontak & WhatsApp order generator otomatis",
      ],
      en: [
        "Custom responsive design for all screen resolutions",
        "Core Web Vitals & on-page technical SEO optimization",
        "Analytics integration (Google Analytics, Meta Pixel)",
        "Automated WhatsApp lead & inquiry generator",
      ],
    },
  },
  {
    id: "webapp",
    title: { id: "Aplikasi Web & Dashboard Kustom", en: "Custom Web Apps & Dashboards" },
    detail: {
      id: "Sistem aplikasi web berbasis cloud untuk efisiensi operasional bisnis: portal internal, sistem inventaris, booking online, hingga platform SaaS kustom.",
      en: "Cloud-based web applications engineered for operational efficiency: internal ERPs, inventory systems, booking portals, and custom SaaS platforms.",
    },
    imageSrc: ProductWebApp.src,
    features: {
      id: [
        "Dashboard admin modern & visualisasi data analitik",
        "Autentikasi aman, manajemen peran & hak akses (RBAC)",
        "Arsitektur database relasional & REST / GraphQL API",
        "Deployment otomatis & infrastruktur cloud scalable",
      ],
      en: [
        "Modern admin dashboard with interactive data charts",
        "Secure user authentication & role-based permissions",
        "Robust database architecture & REST/GraphQL APIs",
        "Automated CI/CD & scalable cloud server deployment",
      ],
    },
  },
  {
    id: "mobileapp",
    title: { id: "Aplikasi Mobile (Android & iOS)", en: "Mobile Apps (Android & iOS)" },
    detail: {
      id: "Jangkau pelanggan langsung di genggaman mereka melalui aplikasi mobile dengan performa gesit, antarmuka nyaman, dan fitur notifikasi otomatis.",
      en: "Reach customers right in their pocket with high-performance cross-platform mobile apps featuring intuitive UX and push notifications.",
    },
    imageSrc: ProductMobileApp.src,
    features: {
      id: [
        "Pengembangan cross-platform efisien (Flutter / React Native)",
        "Integrasi Push Notification & Offline Mode",
        "Integrasi Payment Gateway resmi (Midtrans, Xendit)",
        "Bantuan publikasi ke Google Play Store & Apple App Store",
      ],
      en: [
        "Cross-platform efficiency with Flutter / React Native",
        "Push notifications & offline caching capabilities",
        "Official payment gateway integrations (Midtrans, Stripe)",
        "Assistance with Google Play & App Store publishing",
      ],
    },
  },
  {
    id: "uiux",
    title: { id: "UI/UX Design & Prototipe Interaktif", en: "UI/UX Design & Prototyping" },
    detail: {
      id: "Rancang pengalaman pengguna kelas dunia sebelum memulai koding. Kami membuat design system lengkap, wireframe, dan prototipe klik interaktif di Figma.",
      en: "Craft world-class user journeys before writing a line of code. Complete Figma design systems, wireframing, and interactive clickable prototypes.",
    },
    imageSrc: ProductUIDesign.src,
    features: {
      id: [
        "Riset pengguna & pemetaan alur sistem (User Journey)",
        "Design System & UI Component Library di Figma",
        "Prototipe klik interaktif untuk pengujian awal",
        "Desain siap implementasi (Developer Handoff rapi)",
      ],
      en: [
        "User research & system flow mapping (User Journeys)",
        "Standardized Figma Design System & UI component library",
        "Interactive clickable prototype for stakeholder testing",
        "Clean asset handoff with specs for developer team",
      ],
    },
  },
  {
    id: "maintenance",
    title: { id: "Pemeliharaan & Optimasi Cloud", en: "System Maintenance & Cloud Support" },
    detail: {
      id: "Pastikan sistem digital bisnis Anda selalu aman, online 24/7, dan mutakhir dengan layanan pemeliharaan teknis berkala dan perbaikan cepat.",
      en: "Ensure your digital systems stay secure, online 24/7, and up-to-date with proactive maintenance, cloud monitoring, and rapid bug resolution.",
    },
    imageSrc: ProductWebApp.src,
    features: {
      id: [
        "Monitoring server & uptime 24/7",
        "Backup data berkala & mitigasi pemulihan bencana",
        "Audit berkala performa loading & celah keamanan",
        "Dukungan teknis prioritas untuk penambahan fitur",
      ],
      en: [
        "24/7 server monitoring and uptime protection",
        "Routine database backups & disaster recovery setup",
        "Regular loading speed audit and security patches",
        "Priority technical support for incremental feature upgrades",
      ],
    },
  },
];
---

<section
  class="relative py-20 lg:py-28 max-w-screen-xl mx-auto px-5 lg:px-10 xl:px-8"
  id="product"
>
  <!-- Ambient background glow -->
  <div class="pointer-events-none absolute -right-20 top-1/3 w-80 h-80 bg-secondary/5 rounded-full blur-3xl"></div>

  <!-- Header -->
  <div class="flex flex-col items-center text-center gap-4 mb-12 max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider">
      <span>✨</span>
      <span>{t.badge}</span>
    </div>

    <h2
      class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-extrabold text-slate-900 leading-tight"
      set:html={t.h2}
    />

    <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
      {t.subtitle}
    </p>
  </div>

  <!-- Interactive Services Showcase -->
  <ServicesShowcase client:visible locale={locale} services={services} />
</section>
