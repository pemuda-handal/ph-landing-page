---
const { title, detail, image } = Astro.props;
---

<div
  class="flex flex-col w-[320px] h-[650px] rounded-3xl shadow-md shadow-primary bg-white gap-5"
>
  <div>
    <img
      src={image || "https://picsum.photos/200"}
      alt=""
      class="w-full rounded-t-3xl"
    />
  </div>
  <div class="flex flex-col p-5 gap-5">
    <div class="flex flex-col gap-5">
      <p class="font-bold line-clamp-3 text-left">
        {
          title ||
            " Lorem ipsum dolor sit amet consectetur adipisicing elit. Hic, dicta qui, quis autem neque id sit facere consequatur impedit, explicabo rerum necessitatibus a laudantium optio repudiandae beatae cumque iste repellendusPorro reiciendis, adipisci, laboriosam animi distinctio molestias sed ab dolores dolor cupiditate laudantium, ipsam itaque eum mollitia deserunt autem? Cupiditate adipisci animi nobis facere sint nisi culpa recusandae facilis reprehenderit!"
        }
      </p>
      <p class="text-[#6D6D6D] line-clamp-4 text-left">
        {
          detail ||
            " Lorem ipsum dolor sit, amet consectetur adipisicing elit. Minus optio iure veritatis mollitia, maiores nobis quam reprehenderit, natus commodi, ad delectus dignissimos numquam eius suscipit cupiditate repudiandae est reiciendis rerum."
        }
      </p>
    </div>
    <div class="flex flex-row gap-5 p-2 items-center">
      <button class="font-bold text-primary flex flex-row items-center gap-5">
        Baca Selengkapnya <span
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            width="20px"
            height="20px"
            viewBox="0 0 24 24"
            class="text-primary"
            ><path
              fill="currentColor"
              fill-rule="evenodd"
              d="m7.053 2.158l7.243 7.256a.66.66 0 0 1 .204.483a.7.7 0 0 1-.204.497q-3.93 3.834-7.575 7.401c-.125.117-.625.408-1.011-.024c-.386-.433-.152-.81 0-.966l7.068-6.908l-6.747-6.759q-.369-.509.06-.939q.43-.43.962-.04"
            ></path>
          </svg></span
        >
      </button>
    </div>
  </div>
</div>
