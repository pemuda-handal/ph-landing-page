---
import Footer from "../../components/Footer.astro";
import CarouselHeroBlog from "../../components/CarouselHeroBlog.svelte";
import BlogsList from "../../sections/BlogsList.svelte";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ConnectSection from "../../sections/ConnectSection.astro";
---

<Layout
  title="Blog - Pemuda Handal"
  description="Blog yang berisi artikel-artikel menarik seputar teknologi, programming, dan desain. Dapatkan informasi terbaru seputar dunia teknologi di sini."
  keywords=""
  url="https://pemudahandal.com/blog"
  imageUrl="/images/meta-tags.png"
>
  <Header />

  <main>
    <section
      class="relative mb-10 lg:mb-24 max-w-screen-xl mx-auto lg:px-10 xl:px-0"
    >
      <CarouselHeroBlog client:load />
    </section>

    <section class="px-5 lg:px-10 xl:px-0 pb-20 max-w-screen-xl mx-auto">
      <BlogsList client:load />
    </section>

    <ConnectSection />
  </main>

  <Footer />
</Layout>

<style is:global>
  .skeleton {
    background: #eee;
    position: relative;
  }

  .skeleton::before {
    content: "";
    position: absolute;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.9),
      transparent
    );
    width: 50%;
    height: 100%;
    top: 0;
    left: 0;
    animation: loading 1s infinite ease-in;
  }

  @keyframes loading {
    0% {
      transform: skewX(-10deg) translateX(-100%);
    }
    100% {
      transform: skewX(-10deg) translateX(200%);
    }
  }
</style>
