---
import Logo from "@assets/images/logo.png";
import CarouselHeroBlog from "@components/CarouselHeroBlog.svelte";
import Footer from "@components/Footer.astro";
import HeaderBlog from "@components/HeaderBlog.astro";
import Layout from "@layouts/Layout.astro";
import BlogsList from "@sections/BlogsList.svelte";
import ConnectSection from "@sections/ConnectSection.astro";
import { useTranslations } from "astro-nanointl";

const locale = Astro.currentLocale || "id";
const { translations } = await import(
  `../../locales/${locale}/pages/blog/index.ts`
);

const t = useTranslations(
  {
    title: "Blog - Pemuda Handal",
    description:
      "Blog yang berisi artikel-artikel menarik seputar teknologi, programming, dan desain. Dapatkan informasi terbaru seputar dunia teknologi di sini.",
  },
  {
    data: translations,
    locale,
  }
);

const blogUrl =
  locale === "id"
    ? "https://pemudahandal.com/blog"
    : `https://pemudahandal.com/${locale}/blog`;
---

<script is:inline define:vars={{ Logo }}>
  document.addEventListener("DOMContentLoaded", function () {
    let lastScrollTop = document.documentElement.scrollTop;
    window.onscroll = function () {
      const scroll = document.documentElement.scrollTop;
      const header = document.querySelector("header");
      const duplicatedHeader = document.createElement("div");
      duplicatedHeader.innerHTML = header.innerHTML;
      duplicatedHeader.querySelector(".logo-wrapper").innerHTML =
        `<a href="/"><img src="${Logo.src}" alt="PemudaHandal Logo" class="h-16 lg:h-24 w-auto aspect-video object-cover -ms-4 lg:-ms-5" /></a>`;
      duplicatedHeader.classList.add(
        "fixed-header",
        "fixed",
        "top-0",
        "z-50",
        "w-full",
        "animate-fadeIn",
        "shadow-md",
        "bg-white",
        "text-black"
      );

      const fixedHeader = document.querySelector(".fixed-header");

      if (scroll > lastScrollTop || scroll <= 400) {
        if (fixedHeader) {
          fixedHeader.classList.remove("animate-fadeIn");
          fixedHeader.classList.add("animate-fadeOut");
          setTimeout(() => {
            fixedHeader?.remove();
          }, 300);
        }
      } else if (
        scroll < lastScrollTop &&
        fixedHeader === null &&
        scroll > 400
      ) {
        header.insertAdjacentElement("afterend", duplicatedHeader);
      }
      lastScrollTop = scroll <= 0 ? 0 : scroll;
    };
  });
</script>

<Layout
  title={t.title}
  description={t.description}
  keywords=""
  url={blogUrl}
  imageUrl="/images/meta-tags.png"
>
  <HeaderBlog />

  <main>
    <section
      class="relative mb-10 lg:mb-24 max-w-screen-xl mx-auto lg:px-10 xl:px-0"
    >
      <CarouselHeroBlog pageLocale={locale} client:load />
    </section>

    <section class="px-5 lg:px-10 xl:px-0 pb-20 max-w-screen-xl mx-auto">
      <BlogsList pageLocale={locale} client:load />
    </section>

    <ConnectSection />
  </main>

  <Footer />
</Layout>

<style is:global>
  .skeleton {
    background: #eee;
    position: relative;
  }

  .skeleton::before {
    content: "";
    position: absolute;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.9),
      transparent
    );
    width: 50%;
    height: 100%;
    top: 0;
    left: 0;
    animation: loading 1s infinite ease-in;
  }

  @keyframes loading {
    0% {
      transform: skewX(-10deg) translateX(-100%);
    }
    100% {
      transform: skewX(-10deg) translateX(200%);
    }
  }

  .animate-fadeIn {
    animation: fadeIn 0.3s;
  }

  .animate-fadeOut {
    animation: fadeOut 0.3s;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
</style>
