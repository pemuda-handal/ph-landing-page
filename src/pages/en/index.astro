---
import FloatingActions from "@components/FloatingActions.svelte";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import TechMarquee from "@components/TechMarquee.astro";
import Layout from "@layouts/Layout.astro";
import AboutUsSection from "@sections/AboutUsSection.astro";
import ConnectSection from "@sections/ConnectSection.astro";
import FaqSection from "@sections/FaqSection.astro";
import HeroSection from "@sections/HeroSection.astro";
import PortofolioSection from "@sections/PortofolioSection.astro";
import ProductServiceSection from "@sections/ProductServiceSection.astro";
import TestimoniSection from "@sections/TestimoniSection.astro";
import { useTranslations } from "astro-nanointl";

const locale = Astro.currentLocale || "en";
const { translations } = await import(`../../locales/${locale}/pages/index.ts`);

const t = useTranslations(
  {
    title: "Pemuda Handal - Modern Software Agency & Digital Solutions",
    description:
      "Pemuda Handal is a software agency and digital studio providing high-converting landing pages, custom web & mobile apps, and interactive 360° Virtual Tours.",
  },
  {
    data: translations,
    locale,
  }
);
---

<Layout
  title={t.title}
  description={t.description}
  keywords="pemuda handal, software house indonesia, web development agency, landing page design, custom web app, flutter mobile development, vinterovr 360 virtual tour, ui ux design figma"
  url="https://pemudahandal.id/en"
  imageUrl="/images/meta-tags.png"
>
  <Header />

  <main class="relative overflow-hidden bg-white text-slate-800">
    <!-- 1. Hero Section -->
    <HeroSection />

    <!-- 2. Tech Stack & Solutions Ribbon -->
    <TechMarquee locale="en" />

    <!-- 3. Services & Products Showcase -->
    <ProductServiceSection />

    <!-- 4. Interactive Portfolio Showcase -->
    <PortofolioSection />

    <!-- 5. About Us & Workflow Roadmap -->
    <AboutUsSection />

    <!-- 7. Interactive Client Testimonials -->
    <TestimoniSection locale="en" />

    <!-- 8. Interactive FAQ Accordion -->
    <FaqSection locale="en" />

    <!-- 9. High-impact Connect CTA Banner -->
    <ConnectSection />
  </main>

  <!-- Floating WhatsApp & Scroll-to-Top Actions -->
  <FloatingActions client:load locale="en" />

  <Footer />
</Layout>
