---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ClientListComponent from "../components/ClientListComponent.astro";
import HeroSection from "../sections/HeroSection.astro";
import AboutUsSection from "../sections/AboutUsSection.astro";
import PortofolioSection from "../sections/PortofolioSection.astro";
import ProductServiceSection from "../sections/ProductServiceSection.astro";
import TestimoniSection from "../sections/TestimoniSection.astro";
import ConnectSection from "../sections/ConnectSection.astro";
---

<Layout
  title="Home - PemudaHandal"
  description="Blog yang berisi artikel-artikel menarik seputar teknologi, programming, dan desain. Dapatkan informasi terbaru seputar dunia teknologi di sini."
  keywords="blog, artikel, teknologi, programming, desain, informasi, vinterovr, vintero vr, vintero, vr, vintero virtual reality, virtual reality, vr, vintero vr blog, vintero vr artikel, vintero vr teknologi, vintero vr programming, vintero vr desain, vintero vr informasi"
  url="https://vinterovr.com/blog"
  imageUrl="/images/meta-tags.png"
>
  <Header />
  <main class="relative overflow-hidden">
    <HeroSection />
    <!-- <ClientListComponent /> -->
    <AboutUsSection />
    <PortofolioSection />
    <ProductServiceSection />
    <TestimoniSection />
    <ConnectSection />
  </main>
  <Footer />
</Layout>
