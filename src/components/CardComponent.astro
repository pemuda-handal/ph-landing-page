---
import { Image } from "astro:assets";

interface Props {
  title: string;
  detail: string;
  image: ImageMetadata;
  customClass: string;
  link?: string;
  titleLink?: string;
  size?: "md" | "lg" | "xl";
}

const {
  title,
  detail,
  image,
  customClass,
  link,
  titleLink,
  size = "md",
} = Astro.props;

const titleSizes = {
  md: "",
  lg: "text-lg md:text-xl",
  xl: "text-lg md:text-2xl",
};

const contentSizes = {
  md: "text-sm md:text-base",
  lg: "text-sm md:text-base",
  xl: "text-sm md:text-base",
};
---

<div class=`flex flex-col rounded-3xl shadow-card bg-white ${customClass}`>
  <Image
    src={image || "https://picsum.photos/200"}
    alt=""
    class="w-full aspect-video rounded-t-3xl object-cover"
  />

  <div class="flex items-start flex-col p-5 gap-5 justify-between flex-1">
    <div class="flex flex-col gap-5 flex-1">
      <p class=`font-bold line-clamp-3 text-left ${titleSizes[(size || 'md')]}`>
        {title || "Lorem ipsum dolor sit."}
      </p>
      <p
        class=`text-[#6D6D6D] line-clamp-4 text-left ${contentSizes[(size || 'md')]} card-detail`
      >
        {
          detail ||
            "Lorem ipsum dolor sit, amet consectetur adipisicing elit. Minus optio iure veritatis mollitia, maiores nobis quam reprehenderit, natus commodi, ad delectus dignissimos numquam eius suscipit cupiditate repudiandae est reiciendis rerum."
        }
      </p>
    </div>

    <button class="read-more">
      <a
        class="font-bold text-primary flex flex-row items-center gap-5"
        href={link}
        target="_blank"
      >
        {titleLink || "Baca Selengkapnya"}

        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24px"
          height="24px"
          viewBox="0 0 24 24"
          ><g fill="none" fill-rule="evenodd"
            ><path
              d="M24 0v24H0V0zM12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"
            ></path><path
              fill="currentColor"
              d="M16.06 10.94a1.5 1.5 0 0 1 0 2.12l-5.656 5.658a1.5 1.5 0 1 1-2.121-2.122L12.879 12L8.283 7.404a1.5 1.5 0 0 1 2.12-2.122l5.658 5.657Z"
            ></path></g
          ></svg
        >
      </a>
    </button>
  </div>
</div>
