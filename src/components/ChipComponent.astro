---
const { emote, name } = Astro.props;
---

<div
  class="flex flex-row gap-2 py-2 px-6 bg-chip/10 hover:bg-chip/20 cursor-default rounded-full items-center justify-center text-primary"
>
  <span>
    <img src={emote.src} alt="" class="" />
  </span>

  <p class="font-bold capitalize text-chipText">{name}</p>
</div>
