---
interface Props {
  customClass?: string;
  size?: "sm" | "md" | "lg";
  href?: string;
  target?: "_blank" | "_parent" | "_self" | "_top";
}

const { customClass, size, href, target } = Astro.props;

const sizes = {
  sm: "py-2 px-6 text-sm",
  md: "py-3 px-6",
  lg: "py-4 px-6",
};
---

{
  href ? (
    <a
      href={href}
      target={target}
      class={`bg-primary rounded-full flex flex-row items-center gap-2 text-white font-bold hover:bg-secondary hover:duration-150 ${size ? sizes[size] : sizes["md"]} ${customClass !== undefined ? customClass : ""}`}
    >
      <slot />
    </a>
  ) : (
    <button
      class={`bg-primary rounded-full flex flex-row items-center gap-2 text-white font-bold hover:bg-secondary hover:duration-150 ${size ? sizes[size] : sizes["md"]} ${customClass !== undefined ? customClass : ""}`}
    >
      <slot />
    </button>
  )
}
