<script is:inline>
  function openNavbar() {
    const menu = document.querySelector("#menu");
    menu?.classList.add("-translate-x-full");
  }

  function closeNavbar() {
    const menu = document.querySelector("#menu");
    menu?.classList.remove("-translate-x-full");
  }

  document.addEventListener("DOMContentLoaded", () => {
    function responsive(device) {
      const header = document.querySelector("header");
      const logoWrapper = document.querySelector(".logo-wrapper");
      if (device.matches) {
        header.classList.remove("text-black");
        header.classList.add("text-white");
        logoWrapper.innerHTML =
          '<a href="/"><img src="/logo.png" alt="PemudaHandal Logo" class="w-40 h-10 object-cover" /></a>';
      } else {
        header.classList.remove("text-white");
        header.classList.add("text-black");
        logoWrapper.innerHTML =
          '<a href="/"><img src="/logo.png" alt="PemudaHandal Logo" class="w-40 h-10 object-cover" /></a>';
      }
    }

    const mobileWindow = window.matchMedia("(max-width: 1024px)");

    responsive(mobileWindow);

    mobileWindow.addEventListener("change", function () {
      responsive(mobileWindow);
    });
  });
</script>

<header
  class="flex absolute top-0 w-full py-4 px-5 lg:px-20 bg-transparent items-center justify-between lg:justify-start gap-14 z-50"
>
  <div class="logo-wrapper"></div>
  <nav class="hidden lg:block">
    <ul class="flex text-sm lg:text-base 2xl:text-lg font-bold">
      <li><a href="/blog" class="px-6">Beranda</a></li>
    </ul>
  </nav>
  <button class="lg:hidden" onclick="openNavbar()">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="1em"
      height="1em"
      viewBox="0 0 24 24"
      class="w-6 h-6 fill-black"
      ><path d="M3 18v-2h18v2zm0-5v-2h18v2zm0-5V6h18v2z"></path></svg
    >
  </button>
</header>
<div
  id="menu"
  class="fixed z-50 flex flex-col items-center top-0 h-screen left-full transition transform duration-500 bg-white pt-5 pb-20 px-5 lg:hidden w-screen"
>
  <div class="flex w-full items-center justify-between">
    <a href="/">
      <img src="/logo.png" alt="logo" class="w-40 h-10 object-cover" />
    </a>
    <button onclick="closeNavbar()">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        class="fill-black"
        ><path
          d="M18.3 5.71a.996.996 0 0 0-1.41 0L12 10.59L7.11 5.7A.996.996 0 1 0 5.7 7.11L10.59 12L5.7 16.89a.996.996 0 1 0 1.41 1.41L12 13.41l4.89 4.89a.996.996 0 1 0 1.41-1.41L13.41 12l4.89-4.89c.38-.38.38-1.02 0-1.4"
        ></path></svg
      >
    </button>
  </div>
  <ul class="text-center text-black w-full mt-10">
    <li>
      <a href="/blog" class="inline-block py-5 w-full font-bold">Beranda</a>
    </li>
  </ul>
</div>
