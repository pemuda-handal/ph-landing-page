---
import Logo from "@assets/images/logo.png";
import LogoWhite from "@assets/images/logo-white.svg";
import LanguageSelector from "./LanguageSelector.svelte";
import { useTranslations } from "astro-nanointl";

const pageLocale = (Astro.currentLocale || "id") as "id" | "en";
const { translations } = await import(
  `../locales/${pageLocale}/components/HeaderBlog.ts`
);

const t = useTranslations(
  {
    linkHomeLabel: "Beranda",
  },
  {
    data: translations,
    locale: pageLocale,
  }
);

const homeHref = `/${pageLocale === "id" ? "" : pageLocale}`;

const menuList = [
  {
    label: t.linkHomeLabel,
    href: `/${pageLocale === "id" ? "" : pageLocale + "/"}blog`,
  },
];
---

<script is:inline>
  function openNavbar() {
    const menu = document.querySelector("#menu");
    menu?.classList.add("-translate-x-full");
  }

  function closeNavbar() {
    const menu = document.querySelector("#menu");
    menu?.classList.remove("-translate-x-full");
  }
</script>

<script is:inline define:vars={{ Logo, LogoWhite, homeHref }}>
  document.addEventListener("DOMContentLoaded", () => {
    function responsive(device) {
      const header = document.querySelector("header");
      const logoWrapper = document.querySelector(".logo-wrapper");
      if (device.matches) {
        header.classList.remove("text-black");
        header.classList.add("text-white");
        logoWrapper.innerHTML = `<a href="${homeHref}"><img src="${LogoWhite.src}" alt="PemudaHandal Logo" class="h-11 w-auto aspect-video object-cover" /></a>`;
      } else {
        header.classList.remove("text-white");
        header.classList.add("text-black");
        logoWrapper.innerHTML = `<a href="${homeHref}"><img src="${Logo.src}" alt="PemudaHandal Logo" class="h-16 lg:h-24 w-auto aspect-video object-cover -ms-4 lg:-ms-5" /></a>`;
      }
    }

    const mobileWindow = window.matchMedia("(max-width: 1024px)");

    responsive(mobileWindow);

    mobileWindow.addEventListener("change", function () {
      responsive(mobileWindow);
    });
  });
</script>

<header class="absolute top-0 w-full bg-transparent z-50">
  <div
    class="flex items-center justify-between max-w-screen-2xl mx-auto h-16 px-5 2xl:px-0 lg:h-20 lg:px-10"
  >
    <div class="logo-wrapper"></div>

    <nav class="hidden lg:block flex-1">
      <ul class="flex font-bold">
        {
          menuList.map((menu) => (
            <li>
              <a href={menu.href} class="px-6">
                {menu.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden lg:block">
      <LanguageSelector pageLocale={pageLocale} client:load />
    </div>

    <button class="lg:hidden" onclick="openNavbar()">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="1em"
        height="1em"
        viewBox="0 0 24 24"
        class="w-6 h-6"
        fill="currentColor"
        ><path d="M3 18v-2h18v2zm0-5v-2h18v2zm0-5V6h18v2z"></path></svg
      >
    </button>
  </div>
</header>

<div
  id="menu"
  class="fixed z-50 flex flex-col items-center top-0 h-screen left-full transition transform duration-500 bg-white pb-20 px-5 lg:hidden w-screen"
>
  <div class="flex w-full items-center justify-between">
    <a href="/">
      <img
        src={Logo.src}
        alt="logo"
        class="h-16 w-auto aspect-video object-cover -ms-4"
      />
    </a>
    <button onclick="closeNavbar()">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        class="fill-black"
        ><path
          d="M18.3 5.71a.996.996 0 0 0-1.41 0L12 10.59L7.11 5.7A.996.996 0 1 0 5.7 7.11L10.59 12L5.7 16.89a.996.996 0 1 0 1.41 1.41L12 13.41l4.89 4.89a.996.996 0 1 0 1.41-1.41L13.41 12l4.89-4.89c.38-.38.38-1.02 0-1.4"
        ></path></svg
      >
    </button>
  </div>

  <ul class="text-center text-black w-full mt-10 flex-1">
    {
      menuList.map((menu) => (
        <li>
          <a href={menu.href} class="inline-block py-5 w-full font-bold">
            {menu.label}
          </a>
        </li>
      ))
    }
  </ul>

  <LanguageSelector pageLocale={pageLocale} client:load />
</div>
