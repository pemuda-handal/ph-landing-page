---
interface Props {
  locale?: string;
}

const { locale = "id" } = Astro.props;

const techStack = [
  { name: "Next.js & React", category: "Frontend", icon: "⚛️" },
  { name: "Astro Modern", category: "High Performance", icon: "🚀" },
  { name: "Svelte & SvelteKit", category: "Reactive UI", icon: "⚡" },
  { name: "Tailwind CSS", category: "Design System", icon: "🎨" },
  { name: "Flutter", category: "Mobile Apps", icon: "📱" },
  { name: "Three.js & WebGL", category: "3D & VR 360°", icon: "🌐" },
  { name: "Node.js & Express", category: "Backend API", icon: "🟢" },
  { name: "Python & Fast API", category: "Data & Backend", icon: "🐍" },
  { name: "PostgreSQL & Prisma", category: "Database", icon: "🗄️" },
  { name: "Figma UI/UX", category: "Prototyping", icon: "✨" },
  { name: "Docker & Cloud", category: "DevOps", icon: "☁️" },
];

const label =
  locale === "en"
    ? "Trusted Tech Stack & Digital Solutions"
    : "Teknologi Terpercaya & Solusi Digital Kami";
---

<div class="w-full py-8 border-y border-slate-100 bg-slate-50/70 overflow-hidden relative">
  <!-- Gradient fade edges -->
  <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-slate-50 to-transparent z-10"></div>
  <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-slate-50 to-transparent z-10"></div>

  <div class="max-w-screen-xl mx-auto px-5 mb-4 text-center">
    <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">
      {label}
    </p>
  </div>

  <div class="flex select-none group overflow-hidden">
    <!-- Loop marquee twice for seamless infinite scroll -->
    <div class="flex shrink-0 items-center gap-4 py-2 animate-marquee group-hover:[animation-play-state:paused]">
      {
        techStack.map((tech) => (
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full bg-white border border-slate-200/80 shadow-sm hover:border-primary/50 hover:shadow-card hover:-translate-y-0.5 transition-all duration-200 cursor-default">
            <span class="text-base">{tech.icon}</span>
            <span class="text-sm font-semibold text-slate-800 whitespace-nowrap">{tech.name}</span>
            <span class="text-[10px] font-medium text-primary bg-primary/10 px-2 py-0.5 rounded-full whitespace-nowrap">
              {tech.category}
            </span>
          </div>
        ))
      }
    </div>

    <div class="flex shrink-0 items-center gap-4 py-2 animate-marquee group-hover:[animation-play-state:paused]" aria-hidden="true">
      {
        techStack.map((tech) => (
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full bg-white border border-slate-200/80 shadow-sm hover:border-primary/50 hover:shadow-card hover:-translate-y-0.5 transition-all duration-200 cursor-default">
            <span class="text-base">{tech.icon}</span>
            <span class="text-sm font-semibold text-slate-800 whitespace-nowrap">{tech.name}</span>
            <span class="text-[10px] font-medium text-primary bg-primary/10 px-2 py-0.5 rounded-full whitespace-nowrap">
              {tech.category}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</div>
