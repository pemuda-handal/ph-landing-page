---
import Button from "./ButtonComponent.astro";
import LanguageSelector from "./LanguageSelector.svelte";
import Logo from "@assets/images/logo.png";
---

<script is:inline>
  function openNavbar() {
    const menu = document.querySelector("#menu");
    menu?.classList.add("-translate-x-full");
  }

  function closeNavbar() {
    const menu = document.querySelector("#menu");
    menu?.classList.remove("-translate-x-full");
  }
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.addEventListener("scroll", () => {
      const headerEl = document.querySelector("#header");
      if (window.scrollY > 64) {
        headerEl?.classList.add("shadow-lg");
      } else {
        headerEl?.classList.remove("shadow-lg");
      }
    });
  });
</script>

<header class="top-0 w-full bg-white z-50 text-black sticky" id="header">
  <div
    class="flex items-center justify-between max-w-screen-2xl mx-auto h-16 px-5 2xl:px-0 lg:h-20 lg:px-10"
  >
    <a href="/">
      <img
        src={Logo.src}
        alt="PemudaHandal Logo"
        class="h-16 lg:h-24 w-auto aspect-video object-cover -ms-4 lg:-ms-5"
      />
    </a>

    <nav class="hidden lg:block">
      <ul
        class="flex justify-between text-sm 2xl:text-base text-black font-bold items-center gap-14 xl:gap-20"
      >
        <li><a href="/#about" class="px-8">Tentang</a></li>
        <li><a href="/#product" class="px-8">Produk</a></li>
        <li><a href="/blog" class="px-8">Blog</a></li>
      </ul>
    </nav>

    <div class="items-center gap-5 hidden lg:flex lg:flex-row">
      <LanguageSelector client:load />
      <Button
        size="sm"
        href="https://api.whatsapp.com/send/?phone=6285156353319&type=phone_number&app_absent=0"
        target="_blank"
      >
        Hubungi Kami
      </Button>
    </div>

    <button class="lg:hidden" onclick="openNavbar()">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="1em"
        height="1em"
        viewBox="0 0 24 24"
        class="w-6 h-6 fill-black"
        ><path d="M3 18v-2h18v2zm0-5v-2h18v2zm0-5V6h18v2z"></path></svg
      >
    </button>
  </div>
</header>

<div
  id="menu"
  class="fixed z-50 flex flex-col items-center justify-between top-0 h-screen left-full transition transform duration-500 bg-white pb-20 px-5 lg:hidden w-screen"
>
  <div class="flex w-full items-center justify-between">
    <a href="/" class="flex items-center">
      <img
        src={Logo.src}
        alt="logo"
        class="h-16 w-auto aspect-video object-cover -ms-4"
      />
    </a>
    <button onclick="closeNavbar()">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        class="fill-black"
        ><path
          d="M18.3 5.71a.996.996 0 0 0-1.41 0L12 10.59L7.11 5.7A.996.996 0 1 0 5.7 7.11L10.59 12L5.7 16.89a.996.996 0 1 0 1.41 1.41L12 13.41l4.89 4.89a.996.996 0 1 0 1.41-1.41L13.41 12l4.89-4.89c.38-.38.38-1.02 0-1.4"
        ></path></svg
      >
    </button>
  </div>
  <ul class="text-center text-black w-full font-bold flex flex-col gap-16">
    <li>
      <a href="/#about" class="inline-block py-5 w-full" onclick="closeNavbar()"
        >Tentang</a
      >
    </li>
    <li>
      <a
        href="/#product"
        class="inline-block py-5 w-full"
        onclick="closeNavbar()">Produk</a
      >
    </li>
    <li>
      <a href="/blog" class="inline-block py-5 w-full" onclick="closeNavbar()"
        >Blog</a
      >
    </li>
  </ul>
  <LanguageSelector client:load />
  <Button
    href="https://api.whatsapp.com/send/?phone=6285156353319&type=phone_number&app_absent=0"
    target="_blank"
  >
    Hubungi Kami
  </Button>
</div>
