---
import LanguageSelector from "./LanguageSelector.svelte";
import Logo from "@assets/images/logo.png";
import { useTranslations } from "astro-nanointl";

const pageLocale = Astro.currentLocale || "id";
const { translations } = await import(
  `../locales/${pageLocale}/components/Header.ts`
);

const t = useTranslations(
  {
    linkAboutLabel: "Tentang",
    linkProductLabel: "Layanan",
    linkPortfolioLabel: "Portofolio",
    linkEstimatorLabel: "Kalkulator",
    linkFaqLabel: "FAQ",
    linkBlogLabel: "Blog",
    contactUsLabel: "Konsultasi Gratis",
  },
  {
    data: translations,
    locale: pageLocale,
  }
);

const homeHref = `/${pageLocale === "id" ? "" : pageLocale}`;

const menuList = [
  {
    label: t.linkProductLabel,
    href: `/${pageLocale === "id" ? "" : pageLocale}#product`,
  },
  {
    label: t.linkPortfolioLabel,
    href: `/${pageLocale === "id" ? "" : pageLocale}#portfolio`,
  },
  {
    label: t.linkEstimatorLabel,
    href: `/${pageLocale === "id" ? "" : pageLocale}#estimator`,
  },
  {
    label: t.linkAboutLabel,
    href: `/${pageLocale === "id" ? "" : pageLocale}#about`,
  },
  {
    label: t.linkFaqLabel,
    href: `/${pageLocale === "id" ? "" : pageLocale}#faq`,
  },
  {
    label: t.linkBlogLabel,
    href: `/${pageLocale === "id" ? "" : pageLocale + "/"}blog`,
  },
];
---

<script is:inline>
  function openNavbar() {
    const menu = document.querySelector("#menu");
    menu?.classList.remove("translate-x-full");
    menu?.classList.add("translate-x-0");
    document.body.style.overflow = "hidden";
  }

  function closeNavbar() {
    const menu = document.querySelector("#menu");
    menu?.classList.remove("translate-x-0");
    menu?.classList.add("translate-x-full");
    document.body.style.overflow = "auto";
  }
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const headerEl = document.querySelector("#header");
    const checkScroll = () => {
      if (window.scrollY > 20) {
        headerEl?.classList.add("shadow-sm", "bg-white/95", "backdrop-blur-md");
        headerEl?.classList.remove("bg-white/80");
      } else {
        headerEl?.classList.remove("shadow-sm", "bg-white/95");
        headerEl?.classList.add("bg-white/80", "backdrop-blur-md");
      }
    };
    window.addEventListener("scroll", checkScroll);
    checkScroll();
  });
</script>

<header
  class="fixed top-0 left-0 right-0 w-full bg-white/80 backdrop-blur-md border-b border-slate-100/80 z-50 text-slate-800 transition-all duration-300"
  id="header"
>
  <div
    class="flex items-center justify-between max-w-screen-xl mx-auto h-20 px-5 lg:px-10 xl:px-8"
  >
    <!-- Brand Logo -->
    <a href={homeHref} class="flex items-center gap-2 group">
      <img
        src={Logo.src}
        alt="Pemuda Handal Logo"
        class="h-10 sm:h-12 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:block">
      <ul
        class="flex items-center text-sm font-semibold text-slate-700 gap-6 xl:gap-8"
      >
        {
          menuList.map((menu) => (
            <li>
              <a
                href={menu.href}
                class="hover:text-primary transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-primary hover:after:w-full after:transition-all after:duration-200"
              >
                {menu.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Desktop Language Selector & WhatsApp CTA -->
    <div class="items-center gap-4 hidden lg:flex">
      <LanguageSelector pageLocale={pageLocale} client:load />

      <a
        href="https://api.whatsapp.com/send/?phone=6285156353319&text=Halo%20Pemuda%20Handal%2C%20saya%20ingin%20konsultasi%20proyek.&type=phone_number&app_absent=0"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary hover:bg-secondary text-white font-bold text-xs shadow-md shadow-primary/20 hover:shadow-glow hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
      >
        <span>💬</span>
        <span>{t.contactUsLabel}</span>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      type="button"
      class="lg:hidden p-2 rounded-xl text-slate-800 hover:bg-slate-100 transition-colors"
      onclick="openNavbar()"
      aria-label="Open navigation menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div
  id="menu"
  class="fixed inset-0 z-50 flex flex-col justify-between h-screen w-screen bg-white/95 backdrop-blur-xl p-6 lg:hidden translate-x-full transition-transform duration-300 ease-out"
>
  <div class="flex items-center justify-between border-b border-slate-100 pb-4">
    <a href={homeHref} class="flex items-center" onclick="closeNavbar()">
      <img
        src={Logo.src}
        alt="Pemuda Handal Logo"
        class="h-10 w-auto object-contain"
      />
    </a>
    <button
      type="button"
      onclick="closeNavbar()"
      class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 hover:bg-slate-200 transition-colors"
      aria-label="Close navigation menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <ul class="flex flex-col gap-5 py-6">
    {
      menuList.map((menu) => (
        <li>
          <a
            href={menu.href}
            class="block text-lg font-bold text-slate-800 hover:text-primary transition-colors py-1"
            onclick="closeNavbar()"
          >
            {menu.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="flex flex-col gap-4 border-t border-slate-100 pt-6">
    <div class="flex justify-start">
      <LanguageSelector pageLocale={pageLocale} client:load />
    </div>

    <a
      href="https://api.whatsapp.com/send/?phone=6285156353319&type=phone_number&app_absent=0"
      target="_blank"
      rel="noopener noreferrer"
      class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-full bg-primary hover:bg-secondary text-white font-bold text-sm shadow-md transition-all text-center"
      onclick="closeNavbar()"
    >
      <span>💬</span>
      <span>{t.contactUsLabel}</span>
    </a>
  </div>
</div>
