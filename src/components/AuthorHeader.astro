---
import { Image } from "astro:assets";
import { useTranslations } from "astro-nanointl";
import { toJsLocale } from "@utils/astroToJsLocale";

const { name, photoUrl, date, estimation } = Astro.props;
const dateObj = new Date(date);

const locale = Astro.currentLocale || "id";
const { translations } = await import(
  `../locales/${locale}/components/AuthorHeader.ts`
);

const t = useTranslations(
  {
    authoredBy: "Ditulis Oleh",
    uploaded: "Diunggah",
    reading: "bacaan",
    minute: "menit",
  },
  {
    data: translations,
    locale,
  }
);
---

<div class="flex justify-between flex-wrap gap-3">
  <div class="flex gap-3">
    <Image
      class="skeleton rounded-full object-cover shadow-xl"
      src={photoUrl || "/images/default-avatar.png"}
      alt={name}
      width={40}
      height={40}
    />
    <div>
      <div class="text-[#6D6D6D] text-sm">{t.authoredBy}</div>
      <div class="text-sm text-black font-medium">{name}</div>
    </div>
  </div>
  <div class="text-[#6D6D6D]">
    <div class="text-sm lg:text-end">
      {t.uploaded}
      {
        new Intl.DateTimeFormat(toJsLocale(locale), {
          year: "numeric",
          month: "short",
          day: "numeric",
        }).format(dateObj)
      }
    </div>
    <div class="text-sm lg:text-end">{t.reading} {estimation} {t.minute}</div>
  </div>
</div>
