---
const { name, role } = Astro.props;
---

<div class="flex flex-row gap-4 mt-10 mb-10">
  <img
    class="rounded-full object-cover h-10 w-10 p-0"
    src="https://placehold.co/40"
    alt=""
  />
  <div>
    <p class="capitalize">{name}</p>
    <p class="text-[#6D6D6D] capitalize">{role}</p>
  </div>
</div>
